{
  "name": "publicar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p functions/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply publicar-db --local",
    "provision": "node scripts/provision.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
